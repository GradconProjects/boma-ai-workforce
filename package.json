{
  "name": "boma-ai-workforce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "tsx packages/db/src/cli.ts up",
    "db:rollback": "tsx packages/db/src/cli.ts down",
    "bots:validate": "tsx packages/bots/src/cli.ts validate",
    "bots:sync": "tsx packages/bots/src/cli.ts sync",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm secrets:scan && pnpm bots:validate",
    "worker": "pnpm --filter @boma/worker start",
    "web": "pnpm --filter @boma/web dev",
    "simulate": "pnpm --filter @boma/worker simulate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
