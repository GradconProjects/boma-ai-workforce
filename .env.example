# Copy to .env and fill in. NEVER commit .env. NEVER paste these values into chat.

# --- Database ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (maker by default) --- verify current model IDs in Anthropic docs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAKER=          # strong tier, proposed: claude-sonnet-5-5
ANTHROPIC_MODEL_CHEAP=          # cheap tier, proposed: claude-haiku-5-5

# --- OpenAI (checker by default) --- verify current model IDs in OpenAI docs
OPENAI_API_KEY=
OPENAI_MODEL_CHECKER=           # cheap/mid tier for routine checks
OPENAI_MODEL_CHECKER_STRONG=    # for high-risk outputs / after a revise

# --- DeepSeek (optional third provider) --- verify model IDs at api-docs.deepseek.com
# Used as the checker when OPENAI_MODEL_CHECKER is not set. Requests are processed on
# DeepSeek's servers outside Australia: keep it out of personal/finance work unless you opt in.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=                 # e.g. deepseek-flash (cheap) or deepseek-v4-pro

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_OWNER_USER_ID=         # your numeric Telegram user ID

# --- Facebook (Phase 3) ---
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=     # long-lived Page token
FACEBOOK_GRAPH_VERSION=         # verify current version at build time

# --- Budget / misc ---
USD_TO_AUD_RATE=                # updated monthly
SECRETS_ENCRYPTION_KEY=         # 32-byte key for encrypting stored credentials
TZ=Australia/Sydney

# --- Web app (Creative Studio) ---
OWNER_PASSWORD=                 # at least 12 characters; protects the web app login
SKILLS_PASSCODE=                # at least 6 characters; unlocks skills you label high-risk (30 min)
